# ──────────────────────────────────────────────────────────────
# remember-api 生产环境变量模板
# 用法：cp .env.production.example .env.production 后逐项填写。
# .env.production 含密钥，已被 .gitignore / .dockerignore 排除，绝不提交。
# 生成随机密钥：openssl rand -hex 32
# ──────────────────────────────────────────────────────────────

# ── Supabase Postgres（运行时用事务池连接串，postgres-js + prepare:false 兼容）──
# 用户名必须带项目 ref（postgres.<ref>）：Supavisor 靠它路由租户，裸 postgres 报 no tenant identifier
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# 迁移/DDL 用 session pooler（与上面同一个 pooler 主机，只换端口 5432；事务池跑不了 DDL）
# 别再写 db.<ref>.supabase.co 直连域名：只有 IPv4 的网络解析不到它（无 A 记录）
MIGRATE_DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# 容器内 CA 路径（client.ts verify-full 需要；对应 compose 挂载 ./.secrets/supabase-ca.pem）
DATABASE_SSL_CA=/run/secrets/supabase-ca.pem

# ── Supabase Auth / 项目（auth 模块与 api 网关解耦）──
# 网关-only 模式（只跑 /v1 + /health，无 web 控制台与 /api 管理后台）可留空！
# 完整形态（web 登录 + /api 管理，Supabase JWT 验签）才需填 <ref>
SUPABASE_URL=https://<ref>.supabase.co
# 运行时未用到（网关不读它，`/api` 的 JWT 验签走 jose），可留空
SUPABASE_SERVICE_ROLE_KEY=

# ── 首次引导（db-init 一次性跑 seed 时使用）──
# 先在 Supabase 登录一次，从 auth 用户取 uid（supabase 控制台 Authentication → Users → UUID）
SEED_USER_ID=
SEED_USER_EMAIL=you@example.com
SEED_USER_NAME=admin
# 样例 Profile 的 provider/model（默认 deepseek / deepseek-chat；换厂商改这两行即可）
SEED_PROVIDER=deepseek
SEED_MODEL=deepseek-chat
# 种子写入的固定 admin key；首次验证用，正式用后可在控制台重发
BOOTSTRAP_API_KEY=rma_prod_bootstrap

# ── 签名与加密：生产必须换成随机值，勿用默认 ──
API_KEY_PEPPER=change-me-in-production
ENCRYPTION_KEY=change-me-in-production

# ── 上游模型（任意 OpenAI 兼容厂商；DeepSeek 只是默认示例）──
# 凭据解析顺序（apps/api/src/lib/upstream.ts）：
#   1) 用户自己在控制台或 `npx remember-api model add` 录入的 provider_configs 行（每 provider 一把，加密存库）
#   2) 回退到下面这两个环境变量 —— 单机自用、或还没录过任何 Key 时才需要
# 所以这两个变量可以留空：用户在控制台配过的厂商，走的是库里那把 Key。
UPSTREAM_API_KEY=
# 只在回退路径（上面第 2 条）生效：留空 = 按 Profile 的 provider 用各家默认端点；
# 填了非空值 = 走回退的 Profile 都走这一个地址（custom provider 必须填）。
# 注意它**不会**覆盖 provider_configs 里那行的 baseUrl —— Key 来自哪一行，端点就只取那一行。
UPSTREAM_BASE_URL=
# 归档/recent 摘要的提炼模型，和网关主路径分开配；换厂商必须成对设置
# ARCHIVE_PROVIDER=deepseek
# ARCHIVE_MODEL=deepseek-chat

# ── Server ──
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ── mem0-bridge（docker-compose 里已给 api 注入 http://mem0-bridge:8001；
#    本地直接 `node dist/index.js` 跑时才需要。想走 Postgres 记忆兜底就把 MEM0_BASE_URL 留空）──
#    海外部署预下载 embedding 模型走官方：export HF_ENDPOINT=https://huggingface.co（大陆默认 hf-mirror）
# MEM0_BASE_URL=http://127.0.0.1:8001
# MEM0_API_KEY=
