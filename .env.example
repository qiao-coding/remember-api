# ── Database ──────────────────────────────────────────────
# 运行时用 Supabase 事务池连接串（postgres-js + prepare:false 兼容）
# 用户名必须写成 postgres.<ref>（带上项目 ref）：Supavisor 靠它路由租户，
# 写成裸 postgres 会得到 `no tenant identifier provided` —— 那报错跟密码/区域都不像，极难自查。
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# 迁移/DDL 用 session pooler（与运行时**同一个 pooler 主机**，只把端口换成 5432；事务池跑不了 DDL）
# 别再写 db.<ref>.supabase.co 直连域名：它在只有 IPv4 的网络下解析不到（DNS 无 A 记录）
MIGRATE_DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Supabase Auth ─────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
# 仅用于缺 email claim 的兜底，不在请求热路径
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Memory Backend ────────────────────────────────────────
MEM0_BASE_URL=http://localhost:8001
MEM0_API_KEY=

# ── 上游模型（任意 OpenAI 兼容厂商；DeepSeek 只是默认示例）──
UPSTREAM_API_KEY=
# 留空 = 按 Profile 的 provider 用各家默认端点（deepseek/openai/anthropic/openrouter）；
# 填了非空值 = 所有 Profile 都走这一个地址
UPSTREAM_BASE_URL=

# ── remember-api 自身鉴权 ─────────────────────────────────
# 用于签名 API Key 哈希的 pepper（生产环境必须替换）
API_KEY_PEPPER=change-me-in-production
# 种子用户的固定 admin key（首次启动写入，勿在生产复用）
BOOTSTRAP_API_KEY=rma_bootstrap_local
# 种子脚本指定归属的 Supabase 用户 id（auth.uid()）
SEED_USER_ID=
# 样例 Profile 的 provider/model（默认 deepseek / deepseek-chat）
SEED_PROVIDER=deepseek
SEED_MODEL=deepseek-chat

# ── Server ────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
# 日志级别：trace | debug | info | warn | error
LOG_LEVEL=info
