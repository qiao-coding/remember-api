{
  "name": "@remember/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@opencode-ai/models": "^0.0.64",
    "@remember/core": "workspace:*",
    "@remember/db": "workspace:*",
    "@remember/memory": "workspace:*",
    "@remember/providers": "workspace:*",
    "@remember/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.2.0",
    "jose": "^6.2.10",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
