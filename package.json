{
  "name": "remember-api-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "One API. Same memory. Any AI client. — Stateful Personal AI API",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @remember/db generate",
    "db:migrate": "pnpm --filter @remember/db migrate",
    "db:seed": "pnpm --filter @remember/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.9.0"
  }
}
